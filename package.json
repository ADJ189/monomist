{
  "name": "monomist",
  "version": "0.0.3",
  "description": "A local-first, cinematic music player with a live artwork-driven visualizer, animated background, and 10-band EQ.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lighthouse": "npm run build && lhci autorun",
    "start": "vite preview --host 0.0.0.0"
  },
  "keywords": [
    "music-player",
    "pwa",
    "vite",
    "typescript",
    "web-audio",
    "equalizer"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "eslint": "^10.10.0",
    "globals": "^15.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "liricle": "^4.2.0"
  },
  "overrides": {
    "tmp": "^0.2.4",
    "uuid": "^11.1.1",
    "qs": "^6.15.2",
    "lighthouse": "^13.4.1",
    "puppeteer-core": "^25.3.0",
    "@puppeteer/browsers": "^3.2.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19"
  }
}
