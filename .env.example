# Environment reference for Monomist's Cloudflare Worker (see worker/env.ts
# for the typed shape these correspond to).
#
# This file documents every variable; it isn't loaded directly by
# `wrangler dev` (that reads `.dev.vars` -- copy `.dev.vars.example` to
# `.dev.vars` for local secrets). Public, non-secret vars live in
# wrangler.toml's [vars] instead. This file exists so there's a single
# place that lists everything, for anyone setting up a new environment.

# --- Public config (wrangler.toml [vars]) -----------------------------------
ENVIRONMENT=development
PUBLIC_APP_URL=http://localhost:8787

# --- Secrets (.dev.vars locally, `wrangler secret put` in production) -------
# Google OAuth client, for the future sign-in flow (worker/auth/oauth.ts).
# Not required for the app's current search/video/playback routes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# HMAC key for signed session cookies (worker/auth/session.ts).
# Generate with: openssl rand -base64 32
SESSION_SECRET=
